<% layout("/layouts/boilerplate") %>

<body>
  <div class="row">
    <div class="col-md-6 offset-md-3">
    <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" class="needs-validation" novalidate
      enctype="multipart/form-data">

  <label for="title" class="form-label">Title:</label>
  <input type="text" name="listing[title]" class="form-control" value="<%= listing.title %>" required>
  <div class="invalid-feedback">
    Title is required.
  </div>
      <br>
  <label for="description" class="form-label">Description:</label>
  <input type="text" name="listing[description]" class="form-control" value="<%= listing.description %>" required>
  <div class="invalid-feedback">
    Description is required.
  </div>
      <br>
  <label for="image" class="form-label">Upload new image</label>
  <!-- change name to plain "image" so multer handles it separately -->

  <div class="mb-3">
    previous image:
    <br>
    <img src="<%= originalImgUrl %>" alt="previous image" class="img-fluid">
  </div>

  <input
    type="file"
    name="image" class="form-control"
  >
  <br>
  <label for="price" class="form-label">Price (per night):</label>
  <input type="number" type="number" name="listing[price]" class="form-control" value="<%= listing.price %>" required>
  <div class="invalid-feedback">
    Price is required.
  </div>
  <br>

  <div class="row">
    <div class="col-sm-6">
  <label for="location" class="form-label">Location:</label>
  <input type="text" name="listing[location]" class="form-control" value="<%= listing.location %>" required>
  <div class="invalid-feedback">
    Location is required.
  </div>
  <br>
    </div>
    <div class="col-sm-6">
  <label for="country" class="form-label">Country:</label>
  <input type="text" name="listing[country]" class="form-control" value="<%= listing.country %>" required>
  <div class="invalid-feedback">
    Country is required.
    </div>
     </div> <br>
  </div>
  <button class="btn btn-danger">Update Listing</button>
</form>
    </div>
  </div>

</body>
